# ---- Telegram (Telethon / MTProto - lay tai https://my.telegram.org/apps) ----
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/humanbot            # duong dan file .session
TG_PHONE=                            # tuy chon, de dang nhap khong can nhap tay

# Chi tra loi nhung user nay (id hoac @username, cach nhau bang dau phay).
# BAT BUOC dien - de trong thi bot khong chay (tranh tra loi nham nguoi that).
# Chay `python tools/tg_login.py` de lay danh sach id.
TG_ALLOWED=
TG_ALLOW_EVERYONE=false              # true = chap nhan tra loi tat ca (nguy hiem)
TG_ALLOW_GROUPS=false                # co tra loi trong group khi bi @mention khong

# ---- Zalo: tai khoan CA NHAN (--adapter zalo) ----
# Chay qua cau noi Node + zca-js. Cai truoc: cd zalo_bridge && npm install
# Lan dau chay se hien ma QR trong data/zalo-qr.png de quet bang dien thoai.
ZALO_ALLOWED=                        # id nguoi duoc tra loi, cach nhau bang dau phay
ZALO_ALLOW_EVERYONE=false
ZALO_ALLOW_GROUPS=false
ZALO_BRIDGE_DIR=zalo_bridge
NODE_BIN=node

# ---- Zalo: Official Account (--adapter zalo-oa, can doanh nghiep) ----
# OA KHONG ho tro 'da xem' va 'dang soan tin' - chi con do tre va tach tin.
ZALO_OA_ACCESS_TOKEN=
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_VERIFY_SIGNATURE=false
ZALO_WEBHOOK_PATH=/webhook
PORT=8080

# ---- LLM: chon backend ----
# claude = chay qua claude-cli (khong can API key, dung dang nhap san, dat hon)
# api    = goi thang Messages API (can ANTHROPIC_API_KEY, re hon 2-9 lan
#          tuy do dai hoi thoai - xem: python tools/cost_compare.py)
LLM=claude

# ---- LLM: claude-cli ----
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT=180

# ---- LLM: Messages API (--llm api) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=sonnet          # sonnet | opus | haiku (hoac id day du)
ANTHROPIC_MAX_TOKENS=1000       # tin chat ngan, khong can nhieu
ANTHROPIC_EFFORT=low            # chat thi khong can nghi sau
ANTHROPIC_THINKING=false
ANTHROPIC_MAX_HISTORY=40        # so tin giu lai moi hoi thoai

# ---- Hanh vi ----
PERSONA=config/persona.default.json
TIME_SCALE=1.0                       # 0.2 = chay nhanh gap 5 lan (debug)
DRY_RUN=false                        # true = chi log, khong gui that
LOG_LEVEL=info
